{
  "name": "animetrack",
  "version": "13.10.0",
  "releaseLabel": "13.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run build",
    "lint": "eslint src api server supabase/functions/**/*.js",
    "format": "prettier --write .",
    "format:check": "prettier --check src/modules/safe-html.js src/modules/avatar.js src/modules/supabase-client.js tests/unit/safe-html.test.js eslint.config.js SECURITY.md src/modules/account-service.js api server supabase/functions/**/*.js tests/unit/server-api.test.js tests/unit/account-server.test.js scripts/test-database.mjs tests/unit/push-delivery.test.js",
    "audit": "npm audit --audit-level=high",
    "test:db": "node scripts/test-database.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "pg": "8.23.0",
    "prettier": "3.9.9",
    "supabase": "2.118.0",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.2",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "dompurify": "3.4.16"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  }
}
